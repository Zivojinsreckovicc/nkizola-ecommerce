# Shopify storefront credentials (Shopify admin → Settings → Apps → Develop apps → Storefront API)
SHOPIFY_STORE_DOMAIN="nk-izola.myshopify.com"
SHOPIFY_STOREFRONT_ACCESS_TOKEN="f78b6b8634fc4b028b754cb074183f26"

# Shopify webhook signing secret (Shopify admin → Settings → Notifications → Webhooks,
# "Your webhooks will be signed with …"). Lets /api/revalidate refresh the catalog cache.
SHOPIFY_WEBHOOK_SECRET=

# Canonical site URL, used for metadata and sitemap
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Resend API key — delivers contact form submissions (https://resend.com/api-keys)
RESEND_API_KEY=
